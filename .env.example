# ContinuCare runs in local stable demo mode without any external API keys.
# Runtime data (synthetic demo only)
CONTINUCARE_DB_PATH=data/continucare.db
CONTINUCARE_MODE=local_stable_demo
# IANA timezone used to resolve patient words such as “今天” and “昨天”.
CONTINUCARE_PATIENT_TIMEZONE=Asia/Shanghai

# M5-E optional external adapters. These defaults never read credentials and
# never create an HTTP transport. test_tenant additionally requires its exact
# capability flag, the global egress flag and every empty placeholder below.
CONTINUCARE_FEISHU_MODE=mock
CONTINUCARE_AILY_MODE=mock
CONTINUCARE_BITABLE_MODE=disabled
CONTINUCARE_EXTERNAL_EGRESS_ENABLED=false
CONTINUCARE_FEISHU_TEST_TENANT_ENABLED=false
CONTINUCARE_AILY_TEST_TENANT_ENABLED=false
CONTINUCARE_BITABLE_TEST_TENANT_ENABLED=false
CONTINUCARE_FEISHU_TIMEOUT_SECONDS=8
CONTINUCARE_FEISHU_APP_ID=
CONTINUCARE_FEISHU_APP_SECRET=
CONTINUCARE_FEISHU_RECEIVE_ID_TYPE=
CONTINUCARE_FEISHU_RECEIVE_ID=
CONTINUCARE_AILY_APP_ID=
CONTINUCARE_AILY_SKILL_ID=
CONTINUCARE_BITABLE_APP_TOKEN=
CONTINUCARE_BITABLE_TABLE_ID=
CONTINUCARE_BITABLE_IDEMPOTENCY_SALT=

# Layer-3 Volcengine Doubao adapter. Keep ARK_API_KEY in an ignored local .env or
# deployment secret store; never commit it.
CONTINUCARE_LLM_PROVIDER=volcengine_doubao
CONTINUCARE_LLM_MODEL=doubao-seed-2-0-lite-260215
CONTINUCARE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CONTINUCARE_LLM_API_KEY_ENV=ARK_API_KEY
ARK_API_KEY=
CONTINUCARE_LLM_PROMPT_VERSION=doubao-semantic-extraction-v1
CONTINUCARE_USE_SAFETY_LLM=true
CONTINUCARE_SAFETY_PROMPT_VERSION=doubao-safety-critic-v1
CONTINUCARE_USE_LANGUAGE_LLM=true
CONTINUCARE_LANGUAGE_PROMPT_VERSION=doubao-language-rewrite-v1
# The Layer-4 Summary LLM only groups immutable fact IDs. Keep disabled until
# the controlled-summary tests and operator review have passed in deployment.
CONTINUCARE_USE_SUMMARY_LLM=false
CONTINUCARE_SUMMARY_PROMPT_VERSION=doubao-summary-outline-v1
CONTINUCARE_LLM_TIMEOUT_SECONDS=60
