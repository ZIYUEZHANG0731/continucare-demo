# ContinuCare runs in local stable demo mode without any external API keys.
# Runtime data (synthetic demo only)
CONTINUCARE_DB_PATH=data/continucare.db
CONTINUCARE_MODE=local_stable_demo
FEISHU_ENABLED=false
# IANA timezone used to resolve patient words such as “今天” and “昨天”.
CONTINUCARE_PATIENT_TIMEZONE=Asia/Shanghai

# Layer-3 Xiaomi MiMo adapter. Keep MIMO_API_KEY in an ignored local .env or
# deployment secret store; never commit it.
CONTINUCARE_LLM_PROVIDER=xiaomi_mimo
CONTINUCARE_LLM_MODEL=mimo-v2.5
CONTINUCARE_LLM_BASE_URL=https://api.xiaomimimo.com/v1
CONTINUCARE_LLM_API_KEY_ENV=MIMO_API_KEY
MIMO_API_KEY=
CONTINUCARE_LLM_PROMPT_VERSION=mimo-semantic-extraction-v4
CONTINUCARE_USE_SAFETY_LLM=true
CONTINUCARE_SAFETY_PROMPT_VERSION=mimo-safety-critic-v2
CONTINUCARE_USE_LANGUAGE_LLM=true
CONTINUCARE_LANGUAGE_PROMPT_VERSION=mimo-language-rewrite-v1
# The Layer-4 Summary LLM only groups immutable fact IDs. Keep disabled until
# the controlled-summary tests and operator review have passed in deployment.
CONTINUCARE_USE_SUMMARY_LLM=false
CONTINUCARE_SUMMARY_PROMPT_VERSION=mimo-summary-outline-v1
CONTINUCARE_LLM_TIMEOUT_SECONDS=20
